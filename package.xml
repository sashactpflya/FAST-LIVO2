<?xml version="1.0"?>
<package format="3">
  <name>fast_livo</name>
  <version>2.0.1</version>
  <description>
    FAST-LIVO2: Fast, Direct LiDAR-Inertial-Visual Odometry for ROS 2.
    This package contains the ROS integration, launch files, and tooling.
  </description>

  <maintainer email="dev@livoxtech.com">claydergc</maintainer>
  <author email="zhangji@cmu.edu">Ji Zhang</author>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>vikit_common</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
