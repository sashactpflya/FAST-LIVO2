<launch>
  <arg name="rviz" default="true"/>

  <node pkg="fast_livo" exec="fastlivo_mapping" name="laserMapping" output="screen">
    <param from="$(find-pkg-share fast_livo)/config/HILTI22.yaml"/>
    <param from="$(find-pkg-share fast_livo)/config/camera_fisheye_HILTI22.yaml"/>
  </node>

  <group if="$(var rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz" args="-d $(find-pkg-share fast_livo)/rviz_cfg/hilti.rviz"/>
  </group>
</launch>
