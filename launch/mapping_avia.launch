<launch>
  <arg name="rviz" default="true"/>
  <arg name="gdb" default="false"/>

  <node pkg="fast_livo" exec="fastlivo_mapping" name="fast_livo" output="screen" launch-prefix="$(if $(var gdb) 'gdb -ex run --args' '')">
    <param from="$(find-pkg-share fast_livo)/config/avia.yaml"/>
    <param from="$(find-pkg-share fast_livo)/config/camera_pinhole.yaml"/>
  </node>

  <group if="$(var rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz" args="-d $(find-pkg-share fast_livo)/rviz2/fast_livo2.rviz2"/>
  </group>

  <node pkg="image_transport" exec="republish" name="republish" args="compressed in:=/left_camera/image raw out:=/left_camera/image" output="screen" respawn="true"/>
</launch>
